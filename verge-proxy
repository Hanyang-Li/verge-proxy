#!/usr/bin/env zsh

# verge-proxy: Clash Verge 代理环境变量管理工具

CLASH_CONFIG="$HOME/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev/config.yaml"
CLASH_RUNTIME_CONFIG="$HOME/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev/clash-verge.yaml"
ZSHRC="$HOME/.zshrc"
BLOCK_BEGIN="# >>> verge-proxy >>>"
BLOCK_END="# <<< verge-proxy <<<"
DEFAULT_DELAY_TEST_URL="https://www.gstatic.com/generate_204"
DEFAULT_DELAY_TIMEOUT=5000
DEFAULT_TOOL_PATHS="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"

if [ -n "${PATH:-}" ]; then
  export PATH="$PATH:$DEFAULT_TOOL_PATHS"
else
  export PATH="$DEFAULT_TOOL_PATHS"
fi

# ── 帮助信息 ─────────────────────────────────────────────────────────────────

cmd_help() {
  echo "用法: verge-proxy <命令>"
  echo ""
  echo "命令:"
  echo "  start           读取 Clash Verge 端口，设置代理环境变量"
  echo "  stop            移除代理环境变量"
  echo "  restart         重新读取端口并更新代理环境变量"
  echo "  node            实时测速并切换“手动选择”代理组节点"
  echo "  port            输出 Clash Verge 端口号"
  echo "  install         向 ~/.zshrc 写入/更新 wrapper function（可重复执行以升级）"
  echo ""
  echo "选项:"
  echo "  -h, --help      显示此帮助信息"
  echo ""
  echo "首次使用:"
  echo "  1. verge-proxy install"
  echo "  2. source ~/.zshrc"
  echo "  3. verge-proxy start"
  echo ""
  echo "自动选节点:"
  echo "  VERGE_AUTO_SELECT_COUNTRIES=日本,新加坡 verge-proxy node"
}

# ── 安装 wrapper ──────────────────────────────────────────────────────────────

cmd_install() {
  local site_functions="$(brew --prefix)/share/zsh/site-functions"

  # 写入 zsh 补全文件
  cat > "$site_functions/_verge-proxy" << 'COMP'
#compdef verge-proxy

_verge-proxy() {
  local -a commands
  commands=(
    'start:读取 Clash Verge 端口，设置代理环境变量'
    'stop:移除代理环境变量'
    'restart:重新读取端口并更新代理环境变量'
    'node:实时测速并切换“手动选择”代理组节点'
    'port:输出 Clash Verge 端口号'
    'install:向 ~/.zshrc 写入 wrapper function'
  )

  _arguments -s \
    '(-h --help)'{-h,--help}'[显示帮助信息]' \
    '1:command:->cmds' && return

  case "$state" in
    cmds) _describe 'command' commands ;;
  esac
}

_verge-proxy "$@"
COMP
  echo "✓ 已写入补全文件: $site_functions/_verge-proxy"

  # 生成 wrapper 代码块（含起止标记），写入临时文件
  local block
  block=$(mktemp) || { echo "错误: 无法创建临时文件" >&2; return 1; }
  cat > "$block" << EOF
$BLOCK_BEGIN
# verge-proxy wrapper (added by verge-proxy install)
# 此区块由 verge-proxy install 管理，重新安装会整体覆盖标记之间的内容
verge-proxy() {
  case "\$1" in
    start|stop|restart) eval "\$(command verge-proxy "\$@")" ;;
    *)      command verge-proxy "\$@" ;;
  esac
}
vp() {
  (
    eval "\$(command verge-proxy restart)" >&2 || exit
    if [[ -n \${aliases[\$1]} ]]; then
      eval "\${aliases[\$1]} \${(j: :)\${(@q)@[2,-1]}}"
    else
      "\$@"
    fi
  )
}
$BLOCK_END
EOF

  # 若 ~/.zshrc 中已存在标记区块，则替换标记之间的内容；否则追加到末尾
  if [ -f "$ZSHRC" ] && grep -qF "$BLOCK_BEGIN" "$ZSHRC" && grep -qF "$BLOCK_END" "$ZSHRC"; then
    local tmp
    tmp=$(mktemp) || { echo "错误: 无法创建临时文件" >&2; rm -f "$block"; return 1; }
    awk -v begin="$BLOCK_BEGIN" -v end="$BLOCK_END" -v blockfile="$block" '
      $0 == begin { print_block(); skip = 1; next }
      $0 == end   { skip = 0; next }
      !skip       { print }
      function print_block(   line) {
        while ((getline line < blockfile) > 0) print line
        close(blockfile)
      }
    ' "$ZSHRC" > "$tmp" && cat "$tmp" > "$ZSHRC"
    rm -f "$tmp"
    echo "✓ 已更新 ~/.zshrc 中的 verge-proxy 区块，请执行 source ~/.zshrc 生效"
  else
    printf '\n' >> "$ZSHRC"
    cat "$block" >> "$ZSHRC"
    echo "✓ 已写入 ~/.zshrc，请执行 source ~/.zshrc 生效"
  fi

  rm -f "$block"
}

# ── 开启代理 ──────────────────────────────────────────────────────────────────

_get_port() {
  # 将端口写入调用方指定的变量名，错误信息输出到 stderr 并 return 1。
  # 唯一的端口数据源：start/restart/port 子命令均经此读取。
  local _var="$1"

  if [ ! -f "$CLASH_CONFIG" ]; then
    echo "错误: 找不到 Clash Verge 配置文件" >&2
    echo "路径: $CLASH_CONFIG" >&2
    return 1
  fi

  local _port
  _port=$(grep '^mixed-port:' "$CLASH_CONFIG" | sed 's/mixed-port:[[:space:]]*//' | tr -d '[:space:]')

  if [ -z "$_port" ]; then
    echo "错误: 配置文件中未找到 mixed-port" >&2
    return 1
  fi

  # 通过 typeset -g 把值设置到调用方的变量（在当前进程内，无子 shell）
  typeset -g "$_var=$_port"
}

cmd_port() {
  local port
  _get_port port || return 1
  echo "$port"
}

cmd_start() {
  # 检查环境变量是否已被占用
  local occupied=""
  [ -n "$http_proxy" ]  && occupied="$occupied http_proxy"
  [ -n "$https_proxy" ] && occupied="$occupied https_proxy"
  [ -n "$all_proxy" ]   && occupied="$occupied all_proxy"

  if [ -n "$occupied" ]; then
    echo "echo '错误: 以下环境变量已被占用:$occupied'"
    echo "echo '请先执行 verge-proxy stop 或手动 unset 后再试'"
    echo "return 1 2>/dev/null || exit 1"
    return
  fi

  local port
  _get_port port || { echo "return 1 2>/dev/null || exit 1"; return; }

  echo "export http_proxy=http://127.0.0.1:$port"
  echo "export https_proxy=http://127.0.0.1:$port"
  echo "export all_proxy=socks5://127.0.0.1:$port"
  echo "export no_proxy=localhost,127.0.0.1"
  echo "echo '✓ 代理已开启，端口: $port'"
}

# ── 关闭代理 ──────────────────────────────────────────────────────────────────

cmd_stop() {
  echo "unset http_proxy https_proxy all_proxy no_proxy"
  echo "echo '✓ 代理环境变量已移除'"
}

# ── 重启代理 ──────────────────────────────────────────────────────────────────

cmd_restart() {
  local port
  _get_port port || { echo "return 1 2>/dev/null || exit 1"; return; }

  echo "export http_proxy=http://127.0.0.1:$port"
  echo "export https_proxy=http://127.0.0.1:$port"
  echo "export all_proxy=socks5://127.0.0.1:$port"
  echo "export no_proxy=localhost,127.0.0.1"
  echo "echo '✓ 代理已重启，端口: $port'"
}

# ── 自动选择节点 ──────────────────────────────────────────────────────────────

_get_yaml_value() {
  local file="$1"
  local key="$2"
  local _var="$3"
  local value=""

  if [ -f "$file" ]; then
    value=$(grep "^${key}:" "$file" | head -n 1 | sed "s/^${key}:[[:space:]]*//" | sed 's/[[:space:]]*$//' | sed "s/^['\"]//;s/['\"]$//")
  fi

  typeset -g "$_var=$value"
}

_url_encode() {
  local input="$1"
  local old_lc="${LC_ALL:-}"
  local i c out=""

  export LC_ALL=C
  for (( i = 1; i <= ${#input}; i++ )); do
    c="${input[$i]}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) printf -v out '%s%%%02X' "$out" "'$c" ;;
    esac
  done

  if [ -n "$old_lc" ]; then
    export LC_ALL="$old_lc"
  else
    unset LC_ALL
  fi
  print -r -- "$out"
}

_json_escape() {
  printf "%s" "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

_controller_setup() {
  local socket secret controller

  _get_yaml_value "$CLASH_RUNTIME_CONFIG" "external-controller-unix" socket
  _get_yaml_value "$CLASH_RUNTIME_CONFIG" "secret" secret

  if [ -n "$socket" ] && [ -S "$socket" ]; then
    typeset -g VERGE_CONTROLLER_SOCKET="$socket"
    typeset -g VERGE_CONTROLLER_BASE="http://localhost"
    typeset -g VERGE_CONTROLLER_SECRET="$secret"
    return 0
  fi

  _get_yaml_value "$CLASH_RUNTIME_CONFIG" "external-controller" controller
  if [ -z "$controller" ]; then
    _get_yaml_value "$CLASH_CONFIG" "external-controller" controller
  fi
  if [ -z "$secret" ]; then
    _get_yaml_value "$CLASH_CONFIG" "secret" secret
  fi

  if [ -z "$controller" ]; then
    echo "错误: 找不到可用的 Clash controller。请确认 Clash Verge 已启动并启用 controller 或 external-controller-unix。" >&2
    return 1
  fi

  if [[ "$controller" != http://* && "$controller" != https://* ]]; then
    controller="http://$controller"
  fi
  controller="${controller%/}"
  controller="${controller/http:\/\/0.0.0.0:/http:\/\/127.0.0.1:}"

  typeset -g VERGE_CONTROLLER_SOCKET=""
  typeset -g VERGE_CONTROLLER_BASE="$controller"
  typeset -g VERGE_CONTROLLER_SECRET="$secret"
}

_curl_api() {
  local method="$1"
  local path="$2"
  local body="${3:-}"
  local max_time="${4:-20}"
  local curl_bin="${VERGE_CURL_BIN:-/usr/bin/curl}"
  local -a args

  if [ ! -x "$curl_bin" ]; then
    curl_bin=$(command -v curl) || {
      echo "错误: 找不到 curl" >&2
      return 1
    }
  fi

  args=(-sS --fail --max-time "$max_time")
  if [ -n "$VERGE_CONTROLLER_SOCKET" ]; then
    args+=(--unix-socket "$VERGE_CONTROLLER_SOCKET")
  fi
  if [ -n "$VERGE_CONTROLLER_SECRET" ]; then
    args+=(-H "Authorization: Bearer $VERGE_CONTROLLER_SECRET")
  fi
  if [ "$method" != "GET" ]; then
    args+=(-X "$method")
  fi
  if [ -n "$body" ]; then
    args+=(-H "Content-Type: application/json" -d "$body")
  fi

  "$curl_bin" "${args[@]}" "$VERGE_CONTROLLER_BASE$path"
}

_find_manual_group() {
  local found_group

  found_group=$(awk '
    /^proxy-groups:/ { in_groups = 1; next }
    in_groups && /^- name: / {
      name = substr($0, 9)
      if (name ~ /手动选择/) {
        print name
        exit
      }
    }
  ' "$CLASH_RUNTIME_CONFIG")

  if [ -z "$found_group" ]; then
    echo "错误: 未找到名称包含“手动选择”的代理组" >&2
    return 1
  fi

  print -r -- "$found_group"
}

_group_detail() {
  local group_name="$1"
  local encoded_group

  encoded_group=$(_url_encode "$group_name")
  _curl_api "GET" "/proxies/$encoded_group" "" 10
}

_group_nodes_from_detail() {
  local detail="$1"

  printf "%s" "$detail" |
    sed -n 's/.*"all":\[\([^]]*\)\].*/\1/p' |
    tr ',' '\n' |
    sed 's/^"//;s/"$//' |
    grep -vi '^DIRECT$' |
    grep -vi '^REJECT$' |
    grep -vi 'direct' |
    grep -v '直连' |
    sed '/^$/d'
}

_current_from_detail() {
  local detail="$1"
  printf "%s" "$detail" | sed -n 's/.*"now":"\([^"]*\)".*/\1/p'
}

_delay_from_response() {
  local response="$1"
  printf "%s" "$response" | sed -n 's/.*"delay":\([0-9][0-9]*\).*/\1/p'
}

_test_node_delay() {
  local node="$1"
  local encoded_node encoded_url response delay delay_timeout curl_timeout

  encoded_node=$(_url_encode "$node")
  encoded_url=$(_url_encode "$DEFAULT_DELAY_TEST_URL")
  delay_timeout="${VERGE_DELAY_TIMEOUT_MS:-$DEFAULT_DELAY_TIMEOUT}"
  if [[ ! "$delay_timeout" == <-> ]] || [ "$delay_timeout" -le 0 ]; then
    delay_timeout="$DEFAULT_DELAY_TIMEOUT"
  fi
  curl_timeout=$(( (delay_timeout + 999) / 1000 + 5 ))
  response=$(_curl_api "GET" "/proxies/$encoded_node/delay?url=$encoded_url&timeout=$delay_timeout" "" "$curl_timeout") || return 1
  delay=$(_delay_from_response "$response")
  [ -n "$delay" ] && [ "$delay" -gt 0 ] || return 1
  print -r -- "$delay"
}

_progress_bar() {
  local done_count="$1"
  local total_count="$2"
  local width=20
  local filled=0
  local empty=20

  if [ "$total_count" -gt 0 ]; then
    filled=$(( done_count * width / total_count ))
    empty=$(( width - filled ))
  fi

  printf "["
  printf "%s" "${(l:$filled::#:)${:-}}"
  printf "%s" "${(l:$empty::-:)${:-}}"
  printf "] %s/%s" "$done_count" "$total_count"
}

_test_candidates() {
  local label="$1"
  shift
  local -a candidates=("$@")
  local total="${#candidates[@]}"
  local done_count=0
  local best_name=""
  local best_delay=0
  local node delay

  printf "  - %s: " "$label"
  _progress_bar 0 "$total"

  for node in "${candidates[@]}"; do
    done_count=$((done_count + 1))
    if delay=$(_test_node_delay "$node" 2>/dev/null); then
      if [ "$best_delay" -eq 0 ] || [ "$delay" -lt "$best_delay" ]; then
        best_name="$node"
        best_delay="$delay"
      fi
    fi
    printf "\r  - %s: " "$label"
    _progress_bar "$done_count" "$total"
  done

  if [ -n "$best_name" ]; then
    printf "\n"
    typeset -g VERGE_BEST_NODE="$best_name"
    typeset -g VERGE_BEST_DELAY="$best_delay"
  else
    if [ "$total" -eq 0 ]; then
      printf " 无匹配节点\n"
    else
      printf " 无可用节点\n"
    fi
    typeset -g VERGE_BEST_NODE=""
    typeset -g VERGE_BEST_DELAY=""
  fi
}

_select_node() {
  local group_name="$1"
  local node_name="$2"
  local encoded_group body

  encoded_group=$(_url_encode "$group_name")
  body=$(printf '{"name":"%s"}' "$(_json_escape "$node_name")")
  _curl_api "PUT" "/proxies/$encoded_group" "$body" 10 >/dev/null
}

cmd_node() {
  local group detail current
  local -a all_nodes countries candidates fallback_nodes tried_countries
  local country trimmed node tried matched_country

  _controller_setup || return 1
  group=$(_find_manual_group) || return 1

  detail=$(_group_detail "$group") || {
    echo "错误: 无法读取代理组: $group" >&2
    return 1
  }
  current=$(_current_from_detail "$detail")
  all_nodes=("${(@f)$(_group_nodes_from_detail "$detail")}")

  if [ "${#all_nodes[@]}" -eq 0 ]; then
    echo "错误: 代理组 $group 中没有可测速节点" >&2
    return 1
  fi

  print -r -- "代理组: $group"
  [ -n "$current" ] && print -r -- "当前节点: $current"
  print -r -- "延迟测试:"

  VERGE_BEST_NODE=""
  VERGE_BEST_DELAY=""

  if [ -n "${VERGE_AUTO_SELECT_COUNTRIES:-}" ]; then
    countries=("${(@s:,:)VERGE_AUTO_SELECT_COUNTRIES}")
    for country in "${countries[@]}"; do
      trimmed="${country#"${country%%[![:space:]]*}"}"
      trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
      [ -n "$trimmed" ] || continue
      tried_countries+=("$trimmed")

      candidates=()
      for node in "${all_nodes[@]}"; do
        [[ "$node" == *"$trimmed"* ]] && candidates+=("$node")
      done

      _test_candidates "$trimmed" "${candidates[@]}"
      [ -n "$VERGE_BEST_NODE" ] && break
    done

    if [ -z "$VERGE_BEST_NODE" ]; then
      fallback_nodes=()
      for node in "${all_nodes[@]}"; do
        matched_country=0
        for tried in "${tried_countries[@]}"; do
          [[ "$node" == *"$tried"* ]] && matched_country=1 && break
        done
        [ "$matched_country" -eq 0 ] && fallback_nodes+=("$node")
      done
      _test_candidates "其他节点" "${fallback_nodes[@]}"
    fi
  else
    _test_candidates "全部节点" "${all_nodes[@]}"
  fi

  if [ -z "$VERGE_BEST_NODE" ]; then
    echo "错误: 没有找到可连通节点" >&2
    return 1
  fi

  _select_node "$group" "$VERGE_BEST_NODE" || {
    echo "错误: 无法切换代理组 $group 到 $VERGE_BEST_NODE" >&2
    return 1
  }

  detail=$(_group_detail "$group") || return 1
  current=$(_current_from_detail "$detail")
  if [ "$current" != "$VERGE_BEST_NODE" ]; then
    echo "错误: 切换后校验失败，当前节点: ${current:-未知}" >&2
    return 1
  fi

  print -r -- "选择节点: $VERGE_BEST_NODE ${VERGE_BEST_DELAY}ms"
}

# ── 参数分发 ──────────────────────────────────────────────────────────────────

case "$1" in
  start)
    cmd_start
    ;;
  stop)
    cmd_stop
    ;;
  restart)
    cmd_restart
    ;;
  node)
    cmd_node
    ;;
  port)
    cmd_port
    ;;
  install)
    cmd_install
    ;;
  -h|--help)
    cmd_help
    ;;
  *)
    if [ -z "$1" ]; then
      echo "错误: 请提供命令" >&2
    else
      echo "错误: 未知参数 '$1'" >&2
    fi
    echo "使用 verge-proxy --help 查看使用说明" >&2
    exit 1
    ;;
esac
