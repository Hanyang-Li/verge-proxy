#!/usr/bin/env zsh
set -euo pipefail

script_dir="${0:A:h}"

if [[ -x "$script_dir/target/debug/verge-proxy" ]]; then
  exec "$script_dir/target/debug/verge-proxy" "$@"
fi

if [[ -x "$script_dir/target/release/verge-proxy" ]]; then
  exec "$script_dir/target/release/verge-proxy" "$@"
fi

exec cargo run --quiet --manifest-path "$script_dir/Cargo.toml" -- "$@"
